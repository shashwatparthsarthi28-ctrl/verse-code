rules_version = '2';
// LUDO X - clients are READ-ONLY for everything that matters.
// Balances, dice, match state, ledger and stats are written exclusively by
// Cloud Functions (Admin SDK bypasses these rules). This is what makes
// client-side balance or dice manipulation impossible.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /transactions/{id}   { allow read: if isOwner(uid); allow write: if false; }
      match /matches/{id}        { allow read: if isOwner(uid); allow write: if false; }
      match /notifications/{id}  {
        allow read: if isOwner(uid);
        // the only client write: mark a notification as read
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // Public leaderboard projection (username, wins, earnings only)
    match /leaderboard/{uid} { allow read: if signedIn(); allow write: if false; }

    // Match documents: the participant may watch their own match, never write it.
    match /matches/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
      match /log/{n} { allow read: if signedIn() && get(/databases/$(database)/documents/matches/$(id)).data.uid == request.auth.uid; allow write: if false; }
    }

    // Dice seeds live here; nobody but the server can ever read them.
    match /matchSecrets/{id} { allow read, write: if false; }

    match /config/{doc} { allow read: if signedIn(); allow write: if false; }
    match /stats/{doc}  { allow read, write: if false; }
  }
}
